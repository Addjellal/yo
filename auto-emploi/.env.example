# ── Provider IA ──────────────────────────────────────────────
# "anthropic" (Claude Fable 5, recommandé) ou "ollama" (local, gratuit)
PROVIDER=anthropic

# ── Anthropic (si PROVIDER=anthropic) ────────────────────────
# Clé : https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...
# Modèle (défaut : claude-fable-5, le plus capable).
# Alternative plus économique : claude-sonnet-4-6
ANTHROPIC_MODEL=claude-fable-5

# ── Ollama (si PROVIDER=ollama) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2           # Modèle texte (matching + lettres)
OLLAMA_VISION_MODEL=llava       # Modèle vision (OCR PDF scannés)

# ── Sources d'offres ──────────────────────────────────────────
# Adzuna — API gratuite recommandée (1 000 appels/mois, sans CB)
# Inscription 2 min : https://developer.adzuna.com → "Register"
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# France Travail — inscription gratuite : francetravail.io/partenaire
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret

# LinkedIn — attention : contraire aux CGU LinkedIn
LINKEDIN_EMAIL=votre@email.com
LINKEDIN_PASSWORD=votre_mot_de_passe

# ── Notion (optionnel : export des offres vers une base Notion) ──
# Intégration : https://www.notion.so/my-integrations puis partagez la base
# avec l'intégration. Propriétés attendues : Poste (Title), Entreprise (Text),
# Lieu (Text), Score (Number), Source (Text), URL (URL).
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=...

# ── Paramètres ────────────────────────────────────────────────
OUTPUT_DIR=output
MAX_JOBS_PER_SOURCE=50   # borné 1–200
MIN_MATCH_SCORE=6        # Score minimum /10 pour retenir une offre (0–10)
REQUEST_DELAY=2.0        # Délai entre requêtes (secondes, 0–30)

# Mots-clés éliminatoires : toute offre les contenant est écartée avant l'IA
# EXCLUDE_KEYWORDS=senior,anglais courant,télétravail impossible

# ── Critères par défaut ───────────────────────────────────────
# Pré-remplit le formulaire de recherche (CLI + interface web)
# DEFAULT_SOURCES=adzuna,francetravail
# DEFAULT_SECTORS=data,dev
# DEFAULT_LOCATION=Paris
# DEFAULT_COUNTRY=fr
# DEFAULT_EXPERIENCE=junior

# ── Routage IA par tâche ──────────────────────────────────────
# Chaque tâche peut utiliser un backend différent (ollama ou anthropic).
# Laissez vide pour hériter de PROVIDER.
# AI_PRESCORE_BACKEND=ollama     # présélection rapide → local recommandé
# AI_PRESCORE_MODEL=llama3.2
# AI_MATCH_BACKEND=anthropic     # scoring détaillé → Claude recommandé
# AI_MATCH_MODEL=claude-fable-5
# AI_LETTER_BACKEND=anthropic    # rédaction lettre → Claude recommandé
# AI_LETTER_MODEL=claude-fable-5
# AI_FALLBACK=ollama             # backend de secours si le principal échoue

# ── Lettres de motivation ─────────────────────────────────────
# Guides de rédaction injectés dans le prompt : prompts/skills/lettre_fr.md
# (FR, Vous-Moi-Nous) et cover_letter_en.md (EN, orientée résultats) —
# éditez ces fichiers pour affiner les consignes, relus à chaque lettre.
# LETTER_EXAMPLES=on             # on = imiter le style de vos lettres passées (few-shot)

# ── Coordonnées candidat (en-tête des lettres de motivation) ──
# CANDIDATE_NAME=Prénom Nom
# CANDIDATE_EMAIL=prenom.nom@email.com
# CANDIDATE_PHONE=+33 6 00 00 00 00
# CANDIDATE_CITY=Paris, France
