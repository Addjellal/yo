tests_schema_autogen/mocs_compilation.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tests_schema.dir/build.make CMakeFiles/tests_schema.dir/tests_schema_autogen/mocs_compilation.cpp.i
.PHONY : tests_schema_autogen/mocs_compilation.cpp.i

tests_schema_autogen/mocs_compilation.s: tests_schema_autogen/mocs_compilation.cpp.s
.PHONY : tests_schema_autogen/mocs_compilation.s

# target to generate assembly for a file
tests_schema_autogen/mocs_compilation.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/tests_schema.dir/build.make CMakeFiles/tests_schema.dir/tests_schema_autogen/mocs_compilation.cpp.s
.PHONY : tests_schema_autogen/mocs_compilation.cpp.s

