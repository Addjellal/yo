# ── Provider IA ──────────────────────────────────────────────
# Choisissez "anthropic" ou "ollama"
PROVIDER=ollama

# ── Ollama (si PROVIDER=ollama) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2           # Modèle texte (matching + lettres)
OLLAMA_VISION_MODEL=llava       # Modèle vision (OCR PDF scannés)

# ── Anthropic (si PROVIDER=anthropic) ────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Sources d'offres (toutes optionnelles sauf Indeed/WTTJ) ──
# France Travail — inscription gratuite : francetravail.io/partenaire
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret

# LinkedIn — attention : contraire aux CGU LinkedIn
LINKEDIN_EMAIL=votre@email.com
LINKEDIN_PASSWORD=votre_mot_de_passe

# ── Paramètres ────────────────────────────────────────────────
OUTPUT_DIR=output
MAX_JOBS_PER_SOURCE=50
MIN_MATCH_SCORE=6        # Score minimum /10 pour retenir une offre
REQUEST_DELAY=2.0        # Délai entre requêtes (secondes)
