# Clé API Anthropic (obligatoire)
ANTHROPIC_API_KEY=sk-ant-...

# France Travail API (optionnel - inscription sur francetravail.io/partenaire)
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret

# LinkedIn (optionnel - attention : utilisation à vos risques)
LINKEDIN_EMAIL=votre@email.com
LINKEDIN_PASSWORD=votre_mot_de_passe

# Paramètres
OUTPUT_DIR=output
MAX_JOBS_PER_SOURCE=50
MIN_MATCH_SCORE=6        # Score minimum sur 10 pour retenir une offre
REQUEST_DELAY=2.0        # Délai entre requêtes en secondes
