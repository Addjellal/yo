# Conventions de formatage partagées par tous les éditeurs
# (VS Code, CLion, STM32CubeIDE, IntelliJ, vim… via le plugin EditorConfig)
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2
# deux espaces en fin de ligne = retour à la ligne en Markdown : on les garde
trim_trailing_whitespace = false
max_line_length = 80

[*.{c,h,cpp,hpp,ino}]
indent_size = 4

[*.{vhd,vhdl}]
indent_size = 4

[*.java]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 79

[*.{yml,yaml,json,svg}]
indent_size = 2

# Les Makefiles EXIGENT de vraies tabulations
[{Makefile,*.mk}]
indent_style = tab
